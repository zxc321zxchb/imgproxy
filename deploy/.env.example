# Copy to .env, fill the storage settings, then generate signing values with:
#   openssl rand -hex 32
# Run that command twice for two independent values. Never commit .env.
IMGPROXY_KEY=
IMGPROXY_SALT=

# MinIO / OSS S3-compatible endpoint reachable FROM the container.
IMGPROXY_S3_ENDPOINT=http://minio:9000
IMGPROXY_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use the actual media source bucket; this account only needs GetObject access.
IMGPROXY_S3_ALLOWED_BUCKETS=media
IMGPROXY_ALLOWED_SOURCES=s3://media/

# Loopback default. Set to a private host IP for remote backend callers.
IMGPROXY_HOST_IP=127.0.0.1
IMGPROXY_HOST_PORT=8080
